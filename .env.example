# Spring Dales Academy - Environment Variables Blueprint
# Copy this file to .env.local for local development.

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Public Configuration (Safe for Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Private Configuration (Server-Side ONLY - NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Security Rate Limiting Salt
RATE_LIMIT_SECRET_SALT=your-random-salt-string-here
